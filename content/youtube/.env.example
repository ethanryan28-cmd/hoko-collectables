# Copy to content/youtube/.env (gitignored) and fill in. Never commit the real file.

# YouTube Data API v3 — Google Cloud console → APIs & Services → Credentials
YT_API_KEY=
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# Instagram Graph API (Instagram professional account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Shopify Admin API — used to upload reels to Shopify Files (IG needs a public video URL),
# refresh source CSVs (run.py source) and apply the Christmas cutoff (run.py cutoff)
SHOPIFY_STORE=hoko-collectables.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Optional: Piper voice fallback if edge-tts can't connect (e.g. path to en_GB-alan-medium.onnx)
HOKO_PIPER_MODEL=
